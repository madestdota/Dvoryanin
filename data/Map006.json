e,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":1,"tileId":0},"list":[{"code":230,"indent":0,"parameters":[10]},{"code":101,"indent":0,"parameters":["",0,1,0]},{"code":401,"indent":0,"parameters":["Трактир «Медведь». Пахнет горячим тестом,"]},{"code":401,"indent":0,"parameters":["луком и сбитнем."]},{"code":213,"indent":0,"parameters":[2,1,true]},{"code":101,"indent":0,"parameters":["People1",6,0,2]},{"code":401,"indent":0,"parameters":["Григорий Алексеевич! Неужто вы?"]},{"code":401,"indent":0,"parameters":["Два года ни слуху ни духу!"]},{"code":101,"indent":0,"parameters":["Actor1",4,0,2]},{"code":401,"indent":0,"parameters":["Здравствуй, Тихон. Два года одной селёдки."]},{"code":401,"indent":0,"parameters":["Неси расстегаев — самых горячих. И сбитня."]},{"code":101,"indent":0,"parameters":["People1",6,0,2]},{"code":401,"indent":0,"parameters":["Сию минуту! Садитесь, где обычно."]},{"code":221,"indent":0,"parameters":[]},{"code":201,"indent":0,"parameters":[0,6,4,9,8,2]},{"code":230,"indent":0,"parameters":[30]},{"code":222,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["Расстегай горячий, с рыбой и луком."]},{"code":401,"indent":0,"parameters":["Корочка хрустит, сбитень обжигает горло."]},{"code":101,"indent":0,"parameters":["Actor1",4,0,2]},{"code":401,"indent":0,"parameters":["...Вот теперь я дома."]},{"code":401,"indent":0,"parameters":["Никакой Амстердам с этим не сравнится."]},{"code":250,"indent":0,"parameters":[{"name":"Laugh","volume":70,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["За дальним столом громко хохочут."]},{"code":213,"indent":0,"parameters":[-1,2,true]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["Двое ловкачей играют в напёрстки с парнем"]},{"code":401,"indent":0,"parameters":["лет шестнадцати. Парень проигрывает —"]},{"code":401,"indent":0,"parameters":["и, судя по лицу, последние деньги."]},{"code":102,"indent":0,"parameters":[["Вмешаться","Не моё дело"],-1,0,2,0]},{"code":402,"indent":0,"parameters":[0,"Вмешаться"]},{"code":121,"indent":1,"parameters":[11,11,0]},{"code":221,"indent":1,"parameters":[]},{"code":201,"indent":1,"parameters":[0,6,13,9,8,2]},{"code":230,"indent":1,"parameters":[20]},{"code":222,"indent":1,"parameters":[]},{"code":101,"indent":1,"parameters":["Actor1",4,0,0]},{"code":401,"indent":1,"parameters":["Позволите сыграть?"]},{"code":101,"indent":1,"parameters":["Evil",1,0,0]},{"code":401,"indent":1,"parameters":["Барин желает? Милости просим!"]},{"code":401,"indent":1,"parameters":["Шарик под одним из трёх напёрстков."]},{"code":401,"indent":1,"parameters":["Угадаете — удвою ставку."]},{"code":101,"indent":1,"parameters":["Actor1",4,0,0]},{"code":401,"indent":1,"parameters":["Можно, я сначала скажу, где шарик?"]},{"code":101,"indent":1,"parameters":["Evil",1,0,0]},{"code":401,"indent":1,"parameters":["Ну, скажите."]},{"code":101,"indent":1,"parameters":["Actor1",4,0,0]},{"code":401,"indent":1,"parameters":["Нигде."]},{"code":213,"indent":1,"parameters":[3,1,true]},{"code":101,"indent":1,"parameters":["Evil",1,0,0]},{"code":401,"indent":1,"parameters":["Чего?.."]},{"code":101,"indent":1,"parameters":["Actor1",4,0,0]},{"code":401,"indent":1,"parameters":["Ты поднимаешь напёрсток двумя пальцами,"]},{"code":401,"indent":1,"parameters":["а мизинец держишь поджатым."]},{"code":401,"indent":1,"parameters":["Шарик у тебя под ним."]},{"code":101,"indent":1,"parameters":["Actor1",4,0,0]},{"code":401,"indent":1,"parameters":["Твой приятель у стены трёт бровь каждый"]},{"code":401,"indent":1,"parameters":["раз, когда парень тянется к нужному"]},{"code":401,"indent":1,"parameters":["напёрстку. Это знак: убирай шарик."]},{"code":213,"indent":1,"parameters":[4,1,true]},{"code":101,"indent":1,"parameters":["Actor1",4,0,0]},{"code":401,"indent":1,"parameters":["А купец, который при мне выиграл у вас"]},{"code":401,"indent":1,"parameters":["три раза подряд, теперь сидит у двери"]},{"code":401,"indent":1,"parameters":["и пьёт за ваш счёт. Подсадной."]},{"code":101,"indent":1,"parameters":["Actor1",4,0,0]},{"code":401,"indent":1,"parameters":["Подними все три."]},{"code":230,"indent":1,"parameters":[30]},{"code":250,"indent":1,"parameters":[{"name":"Cursor2","volume":90,"pitch":100,"pan":0}]},{"code":101,"indent":1,"parameters":["",0,1,0]},{"code":401,"indent":1,"parameters":["Рыжий нехотя поднимает напёрстки."]},{"code":401,"indent":1,"parameters":["Под всеми тремя пусто."]},{"code":250,"indent":1,"parameters":[{"name":"Applause1","volume":50,"pitch":100,"pan":0}]},{"code":101,"indent":1,"parameters":["",0,1,0]},{"code":401,"indent":1,"parameters":["Кто-то из посетителей присвистывает."]},{"code":401,"indent":1,"parameters":["Кто-то смеётся в голос."]},{"code":101,"indent":1,"parameters":["Actor1",4,0,0]},{"code":401,"indent":1,"parameters":["Верни юноше деньги. До копейки."]},{"code":101,"indent":1,"parameters":["Evil",0,0,0]},{"code":401,"indent":1,"parameters":["...Ладно, барин. Твоя взяла."]},{"code":101,"indent":1,"parameters":["",0,1,0]},{"code":401,"indent":1,"parameters":["Шулер отсчитывает монеты. Парень смотрит"]},{"code":401,"indent":1,"parameters":["на Григория так, будто увидел чудо."]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[1,"Не моё дело"]},{"code":101,"indent":1,"parameters":["Actor1",4,0,2]},{"code":401,"indent":1,"parameters":["Не моё дело. Москва учит быстро —"]},{"code":401,"indent":1,"parameters":["научит и его."]},{"code":101,"indent":1,"parameters":["",0,1,2]},{"code":401,"indent":1,"parameters":["Григорий доедает расстегай. Смех"]},{"code":401,"indent":1,"parameters":["за дальним столом становится всё громче."]},{"code":0